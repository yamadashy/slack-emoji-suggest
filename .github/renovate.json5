{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
  ],
  "schedule": ["before 9am on saturday"],
  "rangeStrategy": "bump",
  "dependencyDashboard": false,
  "labels": ["dependencies", "renovate"],
  "packageRules": [
    {
      "matchDepTypes": ["peerDependencies"],
      "enabled": false,
    },
    // Group non-major bumps into one weekly PR and majors into another,
    // so routine updates stay separate from the riskier ones.
    {
      "matchFileNames": ["package.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies",
    },
    {
      "matchFileNames": ["package.json"],
      "matchUpdateTypes": ["major"],
      "groupName": "major dependencies",
    },
    // GitHub Actions get the same split. `pin` and `digest` are grouped
    // with the non-major updates so SHA-pinned actions do not open a PR
    // each.
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github-actions non-major dependencies",
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "github-actions major dependencies",
    },
  ],
  "ignoreDeps": [
    // The Node.js version is bumped intentionally, not by Renovate.
    "node",
  ],
  // Wait a week before opening a PR, so a compromised or broken release
  // has time to be yanked before it reaches this repo.
  "minimumReleaseAge": "7 days",
}
