{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    // The extension's own logic is plain JavaScript, checked only as far as
    // its use from TypeScript goes; the popup is the typed half.
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx"
  },
  "include": [".wxt/tsconfig.json", "**/*.ts", "**/*.tsx", "**/*.js"],
  "exclude": ["node_modules", ".output"]
}
